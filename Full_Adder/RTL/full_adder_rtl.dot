digraph "full_adder" {
label="full_adder";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="KEY_A", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="KEY_B", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="KEY_Cin", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="LED_Cout", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="LED_S", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="a", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="b", color="black", fontcolor="black" ];
n8 [ shape=diamond, label="c1", color="black", fontcolor="black" ];
n9 [ shape=diamond, label="c2", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="cin", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="cout", color="black", fontcolor="black" ];
n12 [ shape=diamond, label="s", color="black", fontcolor="black" ];
n13 [ shape=diamond, label="s1", color="black", fontcolor="black" ];
c16 [ shape=record, label="{{<p14> A}|$3\n$not|{<p15> Y}}",  ];
c17 [ shape=record, label="{{<p14> A}|$4\n$not|{<p15> Y}}",  ];
c18 [ shape=record, label="{{<p14> A}|$5\n$not|{<p15> Y}}",  ];
c19 [ shape=record, label="{{<p14> A}|$7\n$not|{<p15> Y}}",  ];
c20 [ shape=record, label="{{<p14> A}|$8\n$not|{<p15> Y}}",  ];
c22 [ shape=record, label="{{<p14> A|<p21> B}|$6\n$or|{<p15> Y}}",  ];
c25 [ shape=record, label="{{<p6> a|<p7> b}|h1\nhalf_adder|{<p23> carry|<p24> sum}}",  ];
c26 [ shape=record, label="{{<p6> a|<p7> b}|h2\nhalf_adder|{<p23> carry|<p24> sum}}",  ];
n1:e -> c16:p14:w [color="black", fontcolor="black", label=""];
c18:p15:e -> n10:w [color="black", fontcolor="black", label=""];
n10:e -> c26:p7:w [color="black", fontcolor="black", label=""];
c22:p15:e -> n11:w [color="black", fontcolor="black", label=""];
n11:e -> c20:p14:w [color="black", fontcolor="black", label=""];
c26:p24:e -> n12:w [color="black", fontcolor="black", label=""];
n12:e -> c19:p14:w [color="black", fontcolor="black", label=""];
c25:p24:e -> n13:w [color="black", fontcolor="black", label=""];
n13:e -> c26:p6:w [color="black", fontcolor="black", label=""];
n2:e -> c17:p14:w [color="black", fontcolor="black", label=""];
n3:e -> c18:p14:w [color="black", fontcolor="black", label=""];
c20:p15:e -> n4:w [color="black", fontcolor="black", label=""];
c19:p15:e -> n5:w [color="black", fontcolor="black", label=""];
c16:p15:e -> n6:w [color="black", fontcolor="black", label=""];
n6:e -> c25:p6:w [color="black", fontcolor="black", label=""];
c17:p15:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> c25:p7:w [color="black", fontcolor="black", label=""];
c25:p23:e -> n8:w [color="black", fontcolor="black", label=""];
n8:e -> c22:p14:w [color="black", fontcolor="black", label=""];
c26:p23:e -> n9:w [color="black", fontcolor="black", label=""];
n9:e -> c22:p21:w [color="black", fontcolor="black", label=""];
}
